[Unit]
Description=Anthropic Messages API in front of the Antigravity CLI
Documentation=https://github.com/heyobi/claude-code-server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/share/claude-code-server/bin/ccs-agy-bridge
Restart=always
RestartSec=10
StandardOutput=append:%h/.claude/claude-code-server/agy-bridge.log
StandardError=append:%h/.claude/claude-code-server/agy-bridge.log

[Install]
WantedBy=default.target
