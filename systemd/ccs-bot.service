[Unit]
Description=Claude Code Server control bot (Telegram)
Documentation=https://github.com/heyobi/claude-code-server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/share/claude-code-server/bin/ccs-bot
Restart=always
RestartSec=10
StandardOutput=append:%h/.claude/claude-code-server/bot.log
StandardError=append:%h/.claude/claude-code-server/bot.log

[Install]
WantedBy=default.target
