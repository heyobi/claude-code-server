#!/usr/bin/env python3
"""Anthropic Messages API in front of g4f.

    ccs-g4f-bridge            listens on 127.0.0.1:4002

g4f reaches model providers through the endpoints their own web apps use, with
no API key. That makes it free and makes it fragile in equal measure: providers
change, rate-limit and break it constantly, and most of the ones it ships with
now want a browser, a key or a payment. Treat it as a spare wheel, not a tyre.

Unlike the Antigravity bridge this one is stateless, which is simpler and
better: g4f keeps no conversation, so the whole message list goes with every
turn exactly as an ordinary API expects. Tools and the system prompt are
dropped for the same reason they are there — a provider reached this way is a
chat endpoint, not an agent, and handing it Claude Code's toolbox produces
either an error or an apology.
"""

import json
import os
import sys
import uuid
import warnings
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

warnings.filterwarnings("ignore")

HOME = os.path.expanduser("~")
PORT = int(os.environ.get("CCS_G4F_PORT", "4002"))
# LLM7 is the one that answered without a key, a browser or a card. Any other
# provider g4f knows can be named here; nothing else needs to change.
PROVIDER = os.environ.get("CCS_G4F_PROVIDER", "LLM7")
MODEL = os.environ.get("CCS_G4F_MODEL", "")
LOGFILE = os.path.join(HOME, ".claude", "claude-code-server", "g4f-bridge.log")
STORE = os.path.join(HOME, ".config", "claude-code-server", "g4f-providers.json")


def offered():
    """Providers the picker should show: the ones that answered when last asked.

    A hardcoded list would be wrong within the week — these come and go. The
    probe writes what it found; if it has never run, the default is all there
    is to offer.
    """
    try:
        with open(STORE, encoding="utf-8") as handle:
            found = json.load(handle).get("providers") or []
    except (OSError, ValueError):
        found = []
    return found or [PROVIDER]

sys.path.insert(0, os.path.join(HOME, "venvs", "g4f", "lib",
                                "python{}.{}".format(*sys.version_info[:2]),
                                "site-packages"))
try:
    from g4f.client import Client            # noqa: E402
    import g4f.Provider as Providers         # noqa: E402
except ImportError as missing:               # pragma: no cover
    sys.exit("g4f is not importable: {}".format(missing))


def note(line):
    try:
        os.makedirs(os.path.dirname(LOGFILE), exist_ok=True)
        with open(LOGFILE, "a", encoding="utf-8") as handle:
            handle.write(line + "\n")
    except OSError:
        pass


def text_of(content):
    """What a person would recognise as the message.

    A turn carries more than what was typed — tool results, budget notices,
    reminders. They are all bracketed, and passing them on gives a chat
    endpoint something else to answer.
    """
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        parts = [block.get("text", "") for block in content
                 if isinstance(block, dict) and block.get("type") == "text"]
        return "\n".join(p for p in parts if p)
    return ""


# A user turn that no person typed. The client appends its own after yours —
# an environment note, a reminder, the opening line of a resumed session — and
# a chat endpoint answers whichever one comes last. The first reply through
# this bridge was "I won't use the scratchpad directory for temporary files
# anymore", which is a perfectly good answer to the wrong message.
MACHINERY = (
    "<", "caveat:", "this session is being continued", "# environment",
    "[request interrupted", "system-reminder",
)


def typed_by_a_person(said):
    low = said.lstrip().lower()
    return bool(low) and not any(low.startswith(mark) for mark in MACHINERY)


def conversation(payload):
    """The exchange so far, in the shape an OpenAI-style endpoint expects.

    Trimmed to end at the last thing a person actually said: everything after
    it is the client talking to itself, and a provider handed that will answer
    it instead of the question.
    """
    out = []
    for message in payload.get("messages") or []:
        said = text_of(message.get("content")).strip()
        if not said:
            continue
        role = "assistant" if message.get("role") == "assistant" else "user"
        if role == "user" and not typed_by_a_person(said):
            continue
        out.append({"role": role, "content": said})
    while out and out[-1]["role"] != "user":
        out.pop()
    return out


def sse(handler, kind, payload):
    blob = "event: {}\ndata: {}\n\n".format(kind, json.dumps(payload))
    handler.wfile.write(blob.encode("utf-8"))
    handler.wfile.flush()


class Bridge(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *_):
        return

    def send_json(self, status, payload):
        body = json.dumps(payload).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        # The app asks a gateway what it serves before drawing the picker, and
        # a gateway that does not answer shows up as no models at all.
        if self.path.rstrip("/").endswith("/v1/models"):
            return self.send_json(200, {
                "object": "list",
                "data": [{"id": name, "object": "model", "owned_by": "g4f"}
                         for name in offered()]})
        return self.send_json(404, {"type": "error",
                                    "error": {"type": "not_found"}})

    def do_POST(self):
        if not self.path.startswith("/v1/messages"):
            return self.send_json(404, {"type": "error",
                                        "error": {"type": "not_found"}})
        length = int(self.headers.get("Content-Length") or 0)
        try:
            payload = json.loads(self.rfile.read(length) or b"{}")
        except ValueError:
            return self.send_json(400, {"type": "error",
                                        "error": {"type": "invalid_request_error"}})

        said = conversation(payload)
        if not said:
            # The client asks things of its own — a title, a token count. None
            # of them is worth a request to a provider that may rate-limit us.
            return self.empty(payload)

        note("{} messages, last: {!r}".format(len(said), said[-1]["content"][:70]))
        if payload.get("stream"):
            return self.stream_reply(payload, said)
        return self.whole_reply(payload, said)

    def answer(self, said, stream, wanted=""):
        """Whichever provider was asked for, or the default.

        There is no single "g4f model": what you are choosing is which
        provider's endpoint answers, so the model name in the request is taken
        as the provider name. That is what makes the picker useful — the list
        is the providers that were alive when the probe last ran.
        """
        name = wanted if wanted and wanted != "g4f" else PROVIDER
        provider = getattr(Providers, name, None)
        if provider is None:
            raise LookupError("no g4f provider called " + name)
        return Client().chat.completions.create(
            model=MODEL, provider=provider, messages=said, stream=stream)

    def empty(self, payload):
        return self.send_json(200, {
            "id": "msg_" + uuid.uuid4().hex[:24], "type": "message",
            "role": "assistant", "model": payload.get("model") or "g4f",
            "content": [], "stop_reason": "end_turn", "stop_sequence": None,
            "usage": {"input_tokens": 0, "output_tokens": 0}})

    def whole_reply(self, payload, said):
        try:
            result = self.answer(said, False, payload.get("model") or "")
            text = result.choices[0].message.content or ""
        except Exception as bad:                   # noqa: BLE001
            note("failed: {}".format(bad))
            return self.send_json(502, {
                "type": "error",
                "error": {"type": "api_error", "message": str(bad)[:400]}})
        return self.send_json(200, {
            "id": "msg_" + uuid.uuid4().hex[:24], "type": "message",
            "role": "assistant", "model": payload.get("model") or "g4f",
            "content": [{"type": "text", "text": text}],
            "stop_reason": "end_turn", "stop_sequence": None,
            "usage": {"input_tokens": 0, "output_tokens": len(text) // 4}})

    def stream_reply(self, payload, said):
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream")
        self.send_header("Cache-Control", "no-cache")
        # No Content-Length on a stream, so the connection has to be closed at
        # the end or a keep-alive client waits for a body that never finishes.
        self.send_header("Connection", "close")
        self.close_connection = True
        self.end_headers()

        message_id = "msg_" + uuid.uuid4().hex[:24]
        name = payload.get("model") or "g4f"
        try:
            sse(self, "message_start", {
                "type": "message_start",
                "message": {"id": message_id, "type": "message",
                            "role": "assistant", "model": name, "content": [],
                            "stop_reason": None, "stop_sequence": None,
                            "usage": {"input_tokens": 0, "output_tokens": 0}}})
            sse(self, "content_block_start", {
                "type": "content_block_start", "index": 0,
                "content_block": {"type": "text", "text": ""}})
            written = 0
            try:
                for chunk in self.answer(said, True,
                                         payload.get("model") or ""):
                    piece = ""
                    try:
                        piece = chunk.choices[0].delta.content or ""
                    except (AttributeError, IndexError):
                        piece = ""
                    if not piece:
                        continue
                    written += len(piece)
                    sse(self, "content_block_delta", {
                        "type": "content_block_delta", "index": 0,
                        "delta": {"type": "text_delta", "text": piece}})
            except Exception as bad:               # noqa: BLE001
                note("stream failed: {}".format(bad))
                sse(self, "content_block_delta", {
                    "type": "content_block_delta", "index": 0,
                    "delta": {"type": "text_delta",
                              "text": "\n\n[g4f: {}]".format(str(bad)[:200])}})
            sse(self, "content_block_stop",
                {"type": "content_block_stop", "index": 0})
            sse(self, "message_delta", {
                "type": "message_delta",
                "delta": {"stop_reason": "end_turn", "stop_sequence": None},
                "usage": {"output_tokens": written // 4}})
            sse(self, "message_stop", {"type": "message_stop"})
        except (BrokenPipeError, ConnectionResetError):
            return


def main():
    note("ccs-g4f-bridge on 127.0.0.1:{} via {}".format(PORT, PROVIDER))
    print("ccs-g4f-bridge on 127.0.0.1:{} via {}".format(PORT, PROVIDER),
          flush=True)
    ThreadingHTTPServer(("127.0.0.1", PORT), Bridge).serve_forever()


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
