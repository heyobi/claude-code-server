#!/usr/bin/env python3
"""Regenerate the LiteLLM model list from what the provider actually serves.

Hardcoding model names goes stale the week a provider ships a new one. This asks
Google which models your key can call, keeps the ones worth chatting to, writes
them into the gateway config and restarts it. The bot then picks the list up on
its own, because it reads /v1/models rather than a list of its own.

    ccs-gateway-sync [--dry-run]
"""

import json
import os
import re
import subprocess
import sys
import urllib.request

HOME = os.path.expanduser("~")
LITELLM = os.path.join(HOME, "litellm")
CONFIG = os.path.join(LITELLM, "config.yaml")
ENV = os.path.join(LITELLM, ".env")

# Anything whose job is not "hold a conversation" only clutters the menu.
SKIP = ("embedding", "image", "tts", "audio", "lyria", "veo", "imagen",
        "nano-banana", "deep-research", "omni", "customtools", "aqa", "learnlm",
        "transcribe", "computer-use", "robotics", "guard", "rerank")


def env(path):
    values = {}
    try:
        with open(path, encoding="utf-8") as handle:
            for line in handle:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    key, _, value = line.partition("=")
                    values[key.strip()] = value.strip().strip("'\"")
    except OSError:
        pass
    return values


def gemini_models(key):
    url = ("https://generativelanguage.googleapis.com/v1beta/models"
           "?pageSize=200&key=" + key)
    with urllib.request.urlopen(url, timeout=30) as resp:
        payload = json.load(resp)
    out = []
    for model in payload.get("models", []):
        if "generateContent" not in (model.get("supportedGenerationMethods") or []):
            continue
        name = model["name"].replace("models/", "")
        if any(word in name for word in SKIP):
            continue
        if not re.match(r"^gemini-", name):
            continue
        out.append(name)
    return sorted(set(out), key=sort_key)


def sort_key(name):
    """Newest first, pro before flash before lite, previews last."""
    version = re.search(r"(\d+(?:\.\d+)?)", name)
    number = float(version.group(1)) if version else 0.0
    tier = 0 if "pro" in name else (1 if "lite" not in name else 2)
    preview = 1 if "preview" in name or "latest" in name else 0
    return (preview, -number, tier, name)


FALLBACK_DEPTH = 4      # enough to ride out a bad afternoon, short enough to read
AUTO = "gemini-auto"    # one name, several deployments behind it
AUTO_DEPTH = 6


def render(models):
    lines = [
        "# Generated by ccs-gateway-sync. Edit that script, not this file.",
        "model_list:",
    ]
    for name in models:
        lines += [
            "  - model_name: {}".format(name),
            "    litellm_params:",
            "      model: gemini/{}".format(name),
            "      api_key: os.environ/GEMINI_API_KEY",
        ]

    # Falling back after a failure is not enough on its own: on the streaming
    # path this gateway re-raises rather than falling, so the client sees the
    # error, retries without streaming, and every message costs a wasted
    # minute. A model group avoids the failure instead of recovering from it —
    # several deployments under one name, and a deployment that starts
    # refusing is put in cooldown and skipped.
    for name in models[:AUTO_DEPTH]:
        lines += [
            "  - model_name: {}".format(AUTO),
            "    litellm_params:",
            "      model: gemini/{}".format(name),
            "      api_key: os.environ/GEMINI_API_KEY",
        ]

    # Free tier quota is counted per model, and a model can also simply be
    # busy: a 429 and a 503 turned up within an hour of each other, and each
    # stopped a session dead while five other models were answering fine.
    # Give every model somewhere to fall.
    lines += ["", "router_settings:", "  fallbacks:"]
    for name in models:
        others = [m for m in models if m != name][:FALLBACK_DEPTH]
        if others:
            lines.append("    - {}: [{}]".format(name, ", ".join(others)))
    lines.append("    - {}: [{}]".format(AUTO, ", ".join(models[:FALLBACK_DEPTH])))
    lines += [
        "  num_retries: 2",
        "  allowed_fails: 3",
        "  cooldown_time: 60",
        "",
        "litellm_settings:",
        "  drop_params: true",
        "",
    ]
    return "\n".join(lines)


def main():
    dry = "--dry-run" in sys.argv
    key = env(ENV).get("GEMINI_API_KEY")
    if not key or key.startswith("BURAYA"):
        sys.exit("No usable GEMINI_API_KEY in {}".format(ENV))

    try:
        models = gemini_models(key)
    except Exception as exc:
        sys.exit("Could not list models: {}".format(exc))
    if not models:
        sys.exit("The provider returned no chat models.")

    models = [m for m in models if not m.startswith("gemini-2.")]

    print("{} model(s):".format(len(models)))
    print("  {}  (any of the first {})".format(AUTO, AUTO_DEPTH))
    for name in models:
        print("  " + name)

    if dry:
        return
    with open(CONFIG, "w", encoding="utf-8") as handle:
        handle.write(render(models))
    print("\nWrote {}".format(CONFIG))

    restart = subprocess.run(["docker", "restart", "litellm"],
                             capture_output=True, text=True)
    if restart.returncode == 0:
        print("Restarted the gateway.")
    else:
        print("Gateway restart failed: {}".format(restart.stderr.strip()))


if __name__ == "__main__":
    main()
