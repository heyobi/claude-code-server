#!/usr/bin/env python3
"""HTTP control plane for the session pool, and the web client that rides on it.

Why this exists alongside the Telegram bot: a chat app can only show what was
relayed to it while it was listening. The transcript on disk always has more —
every turn, and the model that produced it. Reading from the transcript instead
of from a relay means a client can join late, reconnect, or switch backend
without a gap appearing in what it shows you.

Live updates are Server-Sent Events rather than websockets. The traffic is one
directional, the browser reconnects on its own, and the whole thing is a few
lines of standard library instead of a frame codec.

Commands never reach a model, same as the bot: they run ccs-* and tmux.

    ccs-api [--port N] [--host H]
"""

import argparse
import datetime
import glob
import json
import mimetypes
import os
import re
import secrets
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from ccs_common import (                      # noqa: E402  (path set above)
    CFG, HOME, POOLDIR, PROJDIR, WORKDIR, _CACHE, cached, ccs, ccs_sessions,
    next_auto_name,
    last_model, last_words, pane_lines, pane_progress, pane_ready,
    send_to_session,
    blocks_written, relaunching, session_profile, wait_relaunch, wait_ready,
    session_uuid, tmux, transcript_of,
    turns_from,
)
import ccs_push                              # noqa: E402  (path set above)

WEB = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "web")
TOKEN_FILE = os.path.join(HOME, ".config", "claude-code-server", "api-token")
PROFILES = os.path.join(HOME, ".config", "claude-code-server", "profiles")

TAIL_POLL = 0.3        # seconds between transcript checks while streaming
HEARTBEAT = 15.0       # keep intermediaries from closing an idle SSE stream
HISTORY_MAX = 400      # turns sent on a cold load
GATEWAY_SWEEP = 120.0  # seconds between looks at gateways nobody is using


# --------------------------------------------------------------------------- auth


def token():
    """One shared secret, generated on first run. The tailnet already decides who
    can reach the port; this decides who can drive it."""
    try:
        with open(TOKEN_FILE, encoding="utf-8") as handle:
            value = handle.read().strip()
            if value:
                return value
    except OSError:
        pass
    value = secrets.token_urlsafe(24)
    os.makedirs(os.path.dirname(TOKEN_FILE), exist_ok=True)
    with open(TOKEN_FILE, "w", encoding="utf-8") as handle:
        handle.write(value + "\n")
    os.chmod(TOKEN_FILE, 0o600)
    return value


TOKEN = token()


FAILS = {}                 # client address -> [count, first seen, locked until]
FAIL_LIMIT = 5
FAIL_WINDOW = 600.0
FAIL_LOCK = 900.0


def locked_out(who):
    """Guessing should be expensive. This endpoint can type into a shell, so a
    handful of wrong tokens buys a quarter of an hour of silence rather than
    another try."""
    row = FAILS.get(who)
    if not row:
        return False
    now = time.time()
    if row[2] > now:
        return True
    if now - row[1] > FAIL_WINDOW:
        FAILS.pop(who, None)
    return False


def note_failure(who):
    now = time.time()
    row = FAILS.get(who)
    if not row or now - row[1] > FAIL_WINDOW:
        row = [0, now, 0.0]
    row[0] += 1
    if row[0] >= FAIL_LIMIT:
        row[2] = now + FAIL_LOCK
        sys.stderr.write("locked out {} after {} bad tokens{}".format(
            who, row[0], chr(10)))
    FAILS[who] = row


def authorised(handler, query):
    """EventSource cannot set headers, so the stream may carry it in the query."""
    who = handler.client_address[0]
    if locked_out(who):
        return False
    header = handler.headers.get("Authorization") or ""
    if header.startswith("Bearer "):
        given = header[7:].strip()
    else:
        given = (query.get("token") or [""])[0]
    if given and secrets.compare_digest(given, TOKEN):
        FAILS.pop(who, None)
        return True
    note_failure(who)
    return False


# --------------------------------------------------------------------------- model


def profiles():
    names = ["-"]
    try:
        names += sorted(f[:-4] for f in os.listdir(PROFILES) if f.endswith(".env"))
    except OSError:
        pass
    return names


def profile_env(profile):
    values = {}
    try:
        with open(os.path.join(PROFILES, profile + ".env"), encoding="utf-8") as handle:
            for line in handle:
                if "=" in line and not line.strip().startswith("#"):
                    key, _, value = line.strip().partition("=")
                    values[key.strip()] = value.strip().strip("'\"")
    except OSError:
        pass
    return values


def profile_label(profile):
    """A profile is named after its config file; that is a filename, not a
    heading. CCS_PROFILE_LABEL is what the picker should say."""
    return profile_env(profile).get("CCS_PROFILE_LABEL") or profile


def gateway_models(profile):
    """Ask the gateway what it serves. Hardcoded lists go stale."""
    def produce():
        env = profile_env(profile)
        base = env.get("ANTHROPIC_BASE_URL")
        if not base:
            return []
        import urllib.request
        request = urllib.request.Request(
            base.rstrip("/") + "/v1/models",
            headers={"Authorization": "Bearer " + env.get("ANTHROPIC_AUTH_TOKEN", "")})
        try:
            with urllib.request.urlopen(request, timeout=10) as response:
                payload = json.load(response)
        except Exception:
            return []
        rows = payload.get("data") if isinstance(payload, dict) else payload
        return sorted(r.get("id") for r in (rows or []) if r.get("id"))
    return cached("models:" + profile, 120.0, produce)


CLAUDE_MODELS = ["", "opus", "sonnet", "fable", "haiku"]


def model_tree():
    tree = []
    for name in profiles():
        if name == "-":
            tree.append({"profile": "-", "label": "Claude", "models": CLAUDE_MODELS})
        else:
            tree.append({"profile": name, "label": profile_label(name),
                         "models": gateway_models(name)})
    return tree


def set_profile_model(profile, model):
    """A gateway profile names its model in the env file the launcher sources."""
    path = os.path.join(PROFILES, profile + ".env")
    try:
        with open(path, encoding="utf-8") as handle:
            lines = [l for l in handle.read().splitlines()
                     if not l.startswith("CCS_PROFILE_MODEL=")]
    except OSError:
        return False
    lines.append("CCS_PROFILE_MODEL=" + model)
    with open(path, "w", encoding="utf-8") as handle:
        handle.write("\n".join(lines) + "\n")
    os.chmod(path, 0o600)
    return True


def set_pool_model(model):
    path = os.path.join(HOME, ".config", "claude-code-server", "config")
    try:
        with open(path, encoding="utf-8") as handle:
            lines = [l for l in handle.read().splitlines()
                     if not l.startswith("CCS_MODEL=")]
    except OSError:
        return False
    lines.append('CCS_MODEL="{}"'.format(model))
    with open(path, "w", encoding="utf-8") as handle:
        handle.write(chr(10).join(lines) + chr(10))
    # The config is read once, at startup. Writing the file and not the copy in
    # memory is why the picker went on saying Opus while the session was quite
    # clearly running Fable.
    CFG["CCS_MODEL"] = model
    return True


def app_name():
    return CFG.get("CCS_APP_NAME") or CFG.get("CCS_PREFIX", "Claude Code")


