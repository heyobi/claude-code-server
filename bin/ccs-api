            {"src": "icon-180.png", "sizes": "180x180", "type": "image/png"},
            {"src": "icon-512.png", "sizes": "512x512", "type": "image/png",
             "purpose": "any"},
            {"src": "icon-512.png", "sizes": "512x512", "type": "image/png",
             "purpose": "maskable"},
        ],
    }


# --------------------------------------------------------------------------- state


def agy_steps(uuid, offset=0):
    """Tool calls the Antigravity executor made, as turns of the same shape
    the transcript produces, so a client needs no special case for them.
    """
    if not uuid:
        return [], offset
    path = os.path.join(HOME, ".claude", "claude-code-server", "agy-steps",
                        uuid + ".jsonl")
    turns = []
    try:
        with open(path, "rb") as handle:
            handle.seek(offset)
            data = handle.read()
    except OSError:
        return turns, offset
    used = data.rfind(b"\n") + 1
    if used <= 0:
        return turns, offset
    for raw in data[:used].splitlines():
        if not raw.strip():
            continue
        try:
            row = json.loads(raw.decode("utf-8", "ignore"))
        except ValueError:
            continue
        turns.append({
            "id": row["id"], "role": "tool", "name": row.get("name", "tool"),
            "input": row.get("input") or {}, "ts": row.get("at", ""),
        })
        if row.get("output"):
            turns.append({
                "id": row["id"] + ":r", "role": "result",
                "for": row["id"], "text": row["output"],
                "error": False, "ts": row.get("at", ""),
            })
    return turns, offset + used

def session_model(profile, path=None):
    """Which model this session is on.

    A gateway profile names it in the env file the launcher sources, and that
    is per session. The Claude login takes it from the pool config, which is
    not: it says what the next launch will ask for, so reading it made every
    chat claim whatever was picked last for one of them. The transcript knows
    what actually answered.
    """
    if profile and profile != "-":
        return profile_env(profile).get("CCS_PROFILE_MODEL", "")
    said = last_model(path) if path else ""
    return said or (CFG.get("CCS_MODEL") or "").strip()


def anyone_spoke(path, window=400000):
    """Whether a person ever said anything in this transcript.

    Not the same question as whether we can read a title off the top of it. A
    conversation that opens with editor chatter and a pasted file still had
    somebody in it, and dropping it because the first sixteen kilobytes were
    all machinery is how an imported conversation disappears.
    """
    try:
        with open(path, "rb") as handle:
            return b'"type":"user"' in handle.read(window)
    except OSError:
        return False


def first_words(path, window=64000):
    """What a conversation was about, from the first thing asked in it.

    The head, not the tail: an archive row wants the subject, and the tail
    of a long conversation is usually somebody saying thanks. Sessions that
    were opened and never used have no user message at all, and those are
    not conversations — they are pool slots, and they stay out of the list."""
    try:
        with open(path, "rb") as handle:
            data = handle.read(window)
    except OSError:
        return ""
    for raw in data.split(b"\n"):
        if not raw.strip():
            continue
        try:
            entry = json.loads(raw.decode("utf-8", "ignore"))
        except ValueError:
            continue
        if entry.get("type") != "user":
            continue
        body = (entry.get("message") or {}).get("content")
        if isinstance(body, list):
            body = " ".join(p.get("text", "") for p in body
                            if isinstance(p, dict) and p.get("type") == "text")
        text = (body or "").strip()
        low = text.lower()
        if not text or any(low.startswith(b) for b in BOILERPLATE):
            continue
        return " ".join(text.split())[:90]
    return ""


# A resumed session opens with the client's own nudge, and every resumed
# session opens with the same one.
BOILERPLATE = (
    "continue from where you left off",
    "caveat: the messages below were generated",
    "this session is being continued from a previous",
    "<command-",                     # a slash command, not something anyone said
    "<local-command",
    "<ide_",                         # the editor telling us what is on screen
)


def transcript_cwd(path):
    """The folder a conversation was held in, read off the transcript.

    The directory name Claude Code stores it under is the path with the
    slashes replaced by dashes, which cannot be decoded again — a folder with
    a dash in its name is indistinguishable from a slash. The entries carry
    the real path, so it is read rather than guessed.
    """
    try:
        with open(path, "rb") as handle:
            for _ in range(20):
                line = handle.readline()
                if not line:
                    break
                try:
                    entry = json.loads(line.decode("utf-8", "ignore"))
                except ValueError:
                    continue
                if entry.get("cwd"):
                    return entry["cwd"]
    except OSError:
        pass
    return ""


def past_conversations():
    """Every conversation on the disk that is not currently open.

    Not just this workspace's. Claude Code files a transcript under the folder
    it was held in, so the same machine can carry conversations from several,
    and an archive that hides the others is not the archive. They can all be
    read; only the ones from this workspace can be resumed here, because a
    resume is a session started in a working directory and this server has one.
    """
    live = set()
    for name in ccs_sessions():
        uid = session_uuid(name)
        if uid:
            live.add(uid)
    files = []
    for folder in sorted(glob.glob(os.path.join(os.path.dirname(PROJDIR), "*"))):
        if not os.path.isdir(folder):
            continue
        here = os.path.realpath(folder) == os.path.realpath(PROJDIR)
        try:
            names = os.listdir(folder)
        except OSError:
            continue
        for entry in names:
            if not entry.endswith(".jsonl") or entry[:-6] in live:
                continue
            full = os.path.join(folder, entry)
            try:
                files.append((os.path.getmtime(full), entry[:-6], full, here))
            except OSError:
                continue
    files.sort(reverse=True)
    rows = []
    for at, uuid, full, here in files[:200]:
        topic = first_words(full)
        if not topic:
            if not anyone_spoke(full):
                continue                 # opened, never used
            topic = "(başlıksız konuşma)"
        rows.append({
            "uuid": uuid, "topic": topic, "at": int(at),
            "size": os.path.getsize(full), "here": here,
            "dir": transcript_cwd(full),
        })
    return rows


def local_stamp(ts, shape):
    """A transcript timestamp in the clock of whoever is reading it.

    The file records UTC with a Z on the end. Slicing the string out of it puts
    the wrong hour on every line of a shared conversation, three hours out here
    and some other number elsewhere.
    """
    try:
        when = datetime.datetime.strptime((ts or "")[:19], "%Y-%m-%dT%H:%M:%S")
    except (ValueError, TypeError):
        return ""
    return when.replace(tzinfo=datetime.timezone.utc).astimezone().strftime(shape)


def as_markdown(turns, title):
    """A conversation as something to read somewhere else.

    Markdown rather than a screenshot or our own HTML: it opens in anything,
    it is still the text afterwards, and the code blocks the answers are full
    of survive being pasted. Tool calls come through as a single line each —
    a shared conversation is for reading, and the argument list of a shell
    command nobody ran is not part of what was said.
    """
    out = ["# " + title]
    day = local_stamp(turns[0].get("ts") if turns else "", "%d.%m.%Y")
    if day:
        out.append("")
        out.append("*" + day + "*")
    out.append("")
    for turn in turns:
        role = turn.get("role")
        when = local_stamp(turn.get("ts"), "%H:%M")
        if role == "user":
            out += ["### Soru" + (" · " + when if when else ""), "",
                    (turn.get("text") or "").strip(), ""]
        elif role == "assistant":
            who = turn.get("model") or "asistan"
            out += ["### " + who + (" · " + when if when else ""), "",
                    (turn.get("text") or "").strip(), ""]
        elif role == "tool":
            first = ""
            for value in (turn.get("input") or {}).values():
                if isinstance(value, str) and value.strip():
                    first = " ".join(value.split())[:70]
                    break
            out.append("`{}`{}".format(turn.get("name") or "arac",
                                       "  " + first if first else ""))
            out.append("")
    return (chr(10).join(out)).strip() + chr(10)


# HTTP headers are latin-1, and "ı" is not in it: a filename taken straight
# from a Turkish question crashed the response rather than downloading oddly.
FOLD = str.maketrans("çğıöşüÇĞİÖŞÜ", "cgiosuCGIOSU")


def safe_filename(stem):
    folded = (stem or "").translate(FOLD)
    keep = "".join(c if (c.isascii() and c.isalnum()) or c in "-_" else "-"
                   for c in folded)
    while "--" in keep:
        keep = keep.replace("--", "-")
    return (keep.strip("-") or "konusma")[:60]


def past_path(uuid):
    """Where a past conversation's transcript is, in any folder."""
    if not uuid or not uuid.replace("-", "").isalnum():
        return None
    for folder in glob.glob(os.path.join(os.path.dirname(PROJDIR), "*")):
        full = os.path.join(folder, uuid + ".jsonl")
        if os.path.isfile(full):
            return full
    return None

def short_name(name):
    """The conversation's name without the machine's on the front of it."""
    prefix = CFG.get("CCS_PREFIX", "") + "-"
    return name[len(prefix):] if len(prefix) > 1 and name.startswith(prefix) else name


def describe(name):
    """A session, and what it is doing.

    A busy one is a running job: the spinner already says how long it has been
    going and how many tokens it has spent, so pass that along rather than
    inventing a progress bar.
    """
    ready = pane_ready(name) and not relaunching(name)
    path = transcript_of(name)
    archived = os.path.exists(os.path.join(POOLDIR, name + ".archived"))
    said, at = last_words(path) if path else ("", 0)
    profile = session_profile(name)
    row = {
        "name": name,
        "profile": profile,
        "model": session_model(profile, path),
        "archived": archived,
        "ready": ready,
        "last": said,
        "at": at,
    }
    if not ready:
        live = pane_progress(name)
        row["status"] = live["status"]
        row["preview"] = live["text"][-120:]
    return row


def state():
    # Scanned rather than counted: a transcript with nothing in it is a pool
    # slot, not a conversation. Two minutes of memory keeps it off the path of
    # a poll that runs every few seconds.
    past = cached("past", 120, past_conversations)
    return {
        "past": len(past),
        "prefix": CFG.get("CCS_PREFIX", ""),
        "app": app_name(),
        "workdir": WORKDIR,
        "sessions": [describe(n) for n in ccs_sessions()],
        "profiles": model_tree(),
    }


CHOICE = re.compile(r"^\s*[>❯]?\s*(\d)[.)]\s+(.{2,60})")
PROMPT_HINTS = ("do you want", "proceed", "allow this", "onayl")


def pane_choices(name, lines=None):
    """A session sitting on a numbered prompt, rendered as something tappable."""
    tail = (lines if lines is not None else pane_lines(name))[-25:]
    lowered = [line.lower() for line in tail]
    if not any(hint in line for line in lowered for hint in PROMPT_HINTS):
        return None
    options = [{"key": m.group(1), "label": m.group(2).strip()}
               for m in (CHOICE.match(line) for line in tail) if m]
    if not options:
        return None
    question = next((line.strip() for line, low in zip(tail, lowered)
                     if any(hint in low for hint in PROMPT_HINTS)), "Onay")
    return {"question": question, "options": options}


# --------------------------------------------------------------------------- files


FILE_SKIP = {".git", "node_modules", "__pycache__", ".venv", "dist", "build"}
FILE_MAX = 64 * 1024 * 1024
TEXTY = {
    ".txt": "text/plain", ".md": "text/markdown", ".json": "application/json",
    ".py": "text/plain", ".js": "text/javascript", ".ts": "text/plain",
    ".sh": "text/plain", ".yml": "text/plain", ".yaml": "text/plain",
    ".css": "text/css", ".csv": "text/csv", ".log": "text/plain",
}


PATHISH = re.compile(
    r"(/?(?:[\w.-]+/)*[\w.-]+\."
    r"(?:png|jpe?g|gif|webp|svg|avif|mp3|wav|ogg|m4a|flac|mp4|webm|mov|pdf"
    r"|html?|md|csv|json|txt|log|py|js|ts|sh|ya?ml|c|cpp|rs|go|java))")


def session_files(name):
    """Files this conversation mentioned, that are really there.

    A file browser rooted at the workspace shows you everything on the
    machine, which is not what you want while reading one conversation. What
    you want is what this one produced or was given, so that is what it lists
    — and nothing at all when there is none."""
    path = transcript_of(name)
    seen = []
    blobs = []
    if path:
        try:
            with open(path, encoding="utf-8", errors="ignore") as handle:
                blobs.append(handle.read())
        except OSError:
            pass
    uuid = session_uuid(name)
    if uuid:
        steps = os.path.join(HOME, ".claude", "claude-code-server", "agy-steps",
                             uuid + ".jsonl")
        try:
            with open(steps, encoding="utf-8", errors="ignore") as handle:
                blobs.append(handle.read())
        except OSError:
            pass

    root_dir = os.path.realpath(WORKDIR)
    found = {}
    for candidate in PATHISH.findall(" ".join(blobs)):
        if candidate in found:
            continue
        full = inside(candidate)
        if not full or not os.path.isfile(full):
            continue
        rel = os.path.relpath(full, root_dir)
        if rel in found:
            continue
        try:
            info = os.stat(full)
        except OSError:
            continue
        found[rel] = {
            "name": os.path.basename(rel), "path": rel, "dir": False,
            "size": info.st_size, "at": int(info.st_mtime),
            "kind": kind_of(rel),
        }
    rows = sorted(found.values(), key=lambda r: -r["at"])
    return rows[:60]

def inside(path):
    """Resolve a request to a real path under the workspace, or nothing.

    The API is reachable from the internet, so this is the boundary between
    browsing your project and browsing your disk. Absolute paths are accepted
    when they are already inside — a model writing about a file it just made
    usually writes the whole path.
    """
    root = os.path.realpath(WORKDIR)
    wanted = path or ""
    if os.path.isabs(wanted):
        full = os.path.realpath(wanted)
    else:
        full = os.path.realpath(os.path.join(root, wanted.lstrip("/")))
    if full == root or full.startswith(root + os.sep):
        return full
    return None


def kind_of(name):
    ext = os.path.splitext(name)[1].lower()
    if ext in (".png", ".jpg", ".jpeg", ".gif", ".webp", ".svg", ".avif"):
        return "image"
    if ext in (".mp3", ".wav", ".ogg", ".m4a", ".aac", ".flac"):
        return "audio"
    if ext in (".mp4", ".webm", ".mov", ".m4v"):
        return "video"
    if ext in (".html", ".htm"):
        return "page"
    if ext == ".pdf":
        return "pdf"
    if ext in TEXTY:
        return "text"
    return "file"


def listing(path):
    full = inside(path)
    if not full or not os.path.isdir(full):
        return None
    rows = []
    for name in sorted(os.listdir(full)):
        if name.startswith(".") or name in FILE_SKIP:
            continue
        target = os.path.join(full, name)
        try:
            info = os.stat(target)
        except OSError:
            continue
        rows.append({
            "name": name,
            "path": os.path.relpath(target, os.path.realpath(WORKDIR)),
            "dir": os.path.isdir(target),
            "size": 0 if os.path.isdir(target) else info.st_size,
            "at": int(info.st_mtime),
            "kind": "dir" if os.path.isdir(target) else kind_of(name),
        })
    rows.sort(key=lambda r: (not r["dir"], -r["at"]))
    return rows


# --------------------------------------------------------------------------- push


VIEWERS = {}               # session -> how many streams are open on it
SEEN = {}                  # session -> transcript offset already accounted for
KNOWN_SESSIONS = set()     # so a session appearing can be announced
SWEPT = [0.0]              # when the idle gateways were last looked at
STARTED = [False]          # everything is new on the first pass; that is not news
VIEW_LOCK = threading.Lock()
WATCH_POLL = 3.0


def watching(name, delta):
    with VIEW_LOCK:
        VIEWERS[name] = max(0, VIEWERS.get(name, 0) + delta)


def is_watched(name):
    with VIEW_LOCK:
        return VIEWERS.get(name, 0) > 0


def notifier():
    """Push an answer to the phone, but only when nobody is looking at it.

    A session can finish a long job minutes after you put the phone down, and
    that is the whole point of the feature. It is also why the check is on
    open streams rather than on anything the client says: if the app is in
    front of you the answer is already on screen and a buzz is just noise."""
    while True:
        time.sleep(WATCH_POLL)
        try:
            _CACHE.pop("sessions", None)
            live = ccs_sessions()
            KNOWN_SESSIONS.intersection_update(live)
            for name in live:
                if os.path.exists(os.path.join(POOLDIR, name + ".archived")):
                    # Put away on purpose. Announcing it defeats the point.
                    KNOWN_SESSIONS.add(name)
                    SEEN[name] = os.path.getsize(transcript_of(name) or os.devnull)
                    continue
                if name not in KNOWN_SESSIONS:
                    KNOWN_SESSIONS.add(name)
                    # Not on the first pass: everything is new when we start.
                    if STARTED[0]:
                        ccs_push.send_all({"title": short_name(name),
                                           "body": "Yeni oturum açıldı",
                                           "session": name})
                path = transcript_of(name)
                if not path:
                    continue
                start = SEEN.get(name)
                if start is None:
                    # First sight of a session is not news.
                    SEEN[name] = os.path.getsize(path)
                    continue
                turns, offset = turns_from(path, start)
                SEEN[name] = offset
                if is_watched(name):
                    continue
                said = [t for t in turns if t["role"] == "assistant" and t["text"]]
                if not said:
                    continue
                last = said[-1]
                sent = ccs_push.send_all({
                    "title": short_name(name),
                    "body": last["text"][:180],
                    "session": name,
                })
                for endpoint, status, detail in sent:
                    sys.stderr.write("push {} {} {}{}".format(
                        name, status, detail[:80], chr(10)))
            STARTED[0] = True
            # Gateways nobody is using cost more memory than the sessions do.
            # This is the only thread already awake on a timer, so it is the
            # one that checks.
            if time.time() - SWEPT[0] > GATEWAY_SWEEP:
                SWEPT[0] = time.time()
                ccs("ccs-gateway", "idle-stop", timeout=120)
        except Exception as exc:
            sys.stderr.write("notifier: {}{}".format(exc, chr(10)))


# --------------------------------------------------------------------------- http


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    server_version = "ccs-api"

    def log_message(self, *args):
        pass

    # ---- plumbing

    def split(self):
        path, _, raw = self.path.partition("?")
        query = {}
        for part in raw.split("&"):
            if not part:
                continue
            key, _, value = part.partition("=")
            from urllib.parse import unquote_plus
            query.setdefault(unquote_plus(key), []).append(unquote_plus(value))
        return path, query

    def reply(self, status, payload, ctype="application/json"):
        body = payload if isinstance(payload, bytes) else json.dumps(payload).encode()
        self.send_response(status)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        try:
            self.wfile.write(body)
        except (BrokenPipeError, ConnectionResetError):
            pass

    def body(self):
        length = int(self.headers.get("Content-Length") or 0)
        if not length:
            return {}
        try:
            return json.loads(self.rfile.read(length).decode("utf-8"))
        except ValueError:
            return {}

    # ---- routes

    def do_HEAD(self):
        """Same routing as GET, minus the body. The client uses it to ask
        whether a path it read out of an answer is really a file."""
        path, query = self.split()
        if not authorised(self, query):
            return self.reply(401, {"error": "token"})
        if path == "/api/file":
            wanted = (query.get("path") or [""])[0]
            full = inside(wanted)
            if not full or not os.path.isfile(full):
                return self.reply(404, {"error": "no such file"})
            return self.reply(200, {"ok": True})
        return self.reply(404, {"error": "not found"})

    def do_GET(self):
        path, query = self.split()
        if not path.startswith("/api/"):
            return self.static(path)
        if not authorised(self, query):
            return self.reply(401, {"error": "token"})
        if path == "/api/state":
            return self.reply(200, state())
        if path == "/api/history":
            return self.history(query)
        if path == "/api/events":
            return self.events(query)
        if path == "/api/export":
            # Either a session that is open or a conversation that is not.
            named = (query.get("session") or [""])[0]
            uuid = (query.get("uuid") or [""])[0]
            if named:
                if named not in ccs_sessions():
                    return self.reply(404, {"error": "no such session"})
                full = transcript_of(named)
                # "04" is a slot number, not a name. What the conversation was
                # about is the first thing that was asked in it.
                title = (first_words(full)[:60] if full else "") or short_name(named)
            else:
                full = past_path(uuid)
                title = first_words(full)[:60] if full else ""
            if not full:
                return self.reply(404, {"error": "nothing to export"})
            turns, _ = turns_from(full, 0)
            text = as_markdown(turns, title or "Konuşma")
            body = text.encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/markdown; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Disposition",
                             'attachment; filename="{}.md"'.format(
                                 safe_filename(title or "konusma")))
            self.end_headers()
            try:
                self.wfile.write(body)
            except (BrokenPipeError, ConnectionResetError):
                pass
            return
        if path == "/api/past/turns":
            # Read without starting anything. A closed conversation is a file,
            # and reading a file needs no backend, no subscription and no
            # process — which is the whole point of keeping them.
            full = past_path((query.get("uuid") or [""])[0])
            if not full:
                return self.reply(404, {"error": "no such conversation"})
            turns, _ = turns_from(full, 0)
            return self.reply(200, {
                "turns": turns[-HISTORY_MAX:],
                "dir": transcript_cwd(full),
                "here": os.path.dirname(os.path.realpath(full))
                        == os.path.realpath(PROJDIR),
            })
        if path == "/api/past":
            return self.reply(200, {"entries": cached("past", 120,
                                                      past_conversations)})
        if path == "/api/files":
            named = (query.get("session") or [""])[0]
            if named:
                if named not in ccs_sessions():
                    return self.reply(404, {"error": "no such session"})
                return self.reply(200, {"dir": "", "root": named,
                                        "session": named,
                                        "entries": session_files(named)})
            rows = listing((query.get("dir") or [""])[0])
            if rows is None:
                return self.reply(404, {"error": "no such directory"})
            return self.reply(200, {"dir": (query.get("dir") or [""])[0],
                                    "root": os.path.basename(WORKDIR),
                                    "entries": rows})
        if path == "/api/file":
            return self.file((query.get("path") or [""])[0],
                             (query.get("raw") or [""])[0] == "1")
        if path == "/api/push/key":
            if not ccs_push.available():
                return self.reply(503, {"error": "cryptography not installed"})
            return self.reply(200, {"key": ccs_push.public_key(),
                                    "subscribed": len(ccs_push.load_subs())})
        return self.reply(404, {"error": "no such endpoint"})

    def do_POST(self):
        path, query = self.split()
        if not authorised(self, query):
            return self.reply(401, {"error": "token"})
        # Before body(): on an upload the body is the file, and reading it as
        # json would swallow it.
        if path == "/api/upload":
            return self.upload(query)
        data = self.body()
        if path == "/api/message":
            return self.message(data)
        if path == "/api/profile":
            return self.profile(data)
        if path == "/api/session":
            return self.session(data)
        if path == "/api/permission":
            return self.permission(data)
        if path == "/api/push/subscribe":
            if not ccs_push.available():
                return self.reply(503, {"error": "cryptography not installed"})
            if not (data.get("endpoint") and data.get("keys")):
                return self.reply(400, {"error": "not a subscription"})
            return self.reply(200, {"ok": True, "count": ccs_push.subscribe(data)})
        if path == "/api/push/unsubscribe":
            return self.reply(200, {"ok": True,
                                    "count": ccs_push.unsubscribe(data.get("endpoint", ""))})
        if path == "/api/push/test":
            if not ccs_push.available():
                return self.reply(503, {"error": "cryptography not installed"})
            results = ccs_push.send_all({
                "title": app_name(),
                "body": "Bildirimler calisiyor.",
                "session": (data.get("session") or ""),
            })
            return self.reply(200, {"sent": [{"endpoint": e, "status": st, "detail": d}
                                             for e, st, d in results]})
        return self.reply(404, {"error": "no such endpoint"})

    # ---- handlers

    def history(self, query):
        name = (query.get("session") or [""])[0]
        if name not in ccs_sessions():
            return self.reply(404, {"error": "no such session"})
        path = transcript_of(name)
        if not path:
            return self.reply(200, {"session": name, "turns": [], "offset": 0,
                                    "profile": session_profile(name)})
        turns, offset = turns_from(path, 0)
        steps, _ = agy_steps(session_uuid(name))
        if steps:
            # Interleaved by time: the executor's steps happened between the
            # question and the answer, and that is where they belong.
            turns = sorted(turns + steps, key=lambda t: t.get("ts") or "")
        return self.reply(200, {
            "session": name,
            "turns": turns[-HISTORY_MAX:],
            "offset": offset,
            "profile": session_profile(name),
            "ready": pane_ready(name),
        })

    def events(self, query):
        name = (query.get("session") or [""])[0]
        try:
            offset = int((query.get("offset") or ["0"])[0])
        except ValueError:
            offset = 0
        if name not in ccs_sessions():
            return self.reply(404, {"error": "no such session"})

        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Connection", "keep-alive")
        self.send_header("X-Accel-Buffering", "no")
        self.end_headers()

        path = transcript_of(name)
        steps_at = 0
        quiet_until = 0.0
        held = ""
        # What is already written down does not need previewing again.
        done_blocks = blocks_written(path) if path else 0
        last_beat = time.time()
        was_ready = None
        prompt_shown = None
        shown = ""
        watching(name, +1)
        try:
            while True:
                time.sleep(TAIL_POLL)
                _CACHE.pop("sessions", None)
                current = transcript_of(name)
                if current != path:
                    # The session was relaunched onto another transcript. Tell the
                    # client to start over rather than silently skipping turns.
                    self.emit("reload", {"session": name})
                    return
                if path:
                    turns, offset = turns_from(path, offset)
                    for turn in turns:
                        self.emit("turn", dict(turn, offset=offset))
                        if turn["role"] == "assistant" and (turn.get("text") or ""):
                            done_blocks += 1
                        if turn["role"] == "user":
                            # The pane still has the previous answer on it for
                            # a moment after you press send — Claude Code has
                            # not redrawn yet — and sending that as the live
                            # preview flashed the last answer under the new
                            # question. Nothing is being said yet anyway.
                            shown = ""
                            held = ""
                            done_blocks = 0
                            quiet_until = time.time() + 1.2
                            self.emit("partial", {"text": "", "status": ""})
                # The Antigravity executor's own work, which never reaches the
                # transcript because Claude Code only ever sees the answer.
                steps, steps_at = agy_steps(session_uuid(name), steps_at)
                for turn in steps:
                    self.emit("turn", turn)

                # One capture, three readers. Polling three times a second
                # is only affordable because this is not done three times.
                pane = pane_lines(name)
                ready = pane_ready(name, pane) and not relaunching(name)
                if ready != was_ready:
                    was_ready = ready
                    self.emit("status", {"ready": ready,
                                         "profile": session_profile(name)})
                    if ready and shown:
                        shown = ""       # the finished turn replaces the preview
                        held = ""
                        done_blocks = 0
                        self.emit("partial", {"text": "", "status": ""})

                # While it is generating, the answer exists only on the pane.
                # Reading it there is what makes the client feel connected to a
                # session rather than waiting on one.
                if not ready and time.time() >= quiet_until:
                    live = pane_progress(name, pane, done_blocks)
                    # The pane goes blank for a moment between redraws — a tool
                    # box replacing a line of text, say. Blanking the preview
                    # with it makes the answer flash out and back in for no
                    # reason: nothing was unsaid. Keep what was there and let
                    # the status carry the change.
                    # A character or two is the pane caught mid-redraw, not
                    # something that was said.
                    if len(live["text"]) < 3 and held:
                        live = {"text": held, "status": live["status"]}
                    else:
                        held = live["text"]
                    stamp = live["text"] + "|" + live["status"]
                    if stamp != shown:
                        shown = stamp
                        self.emit("partial", live)

                prompt = pane_choices(name, pane) if not ready else None
                fingerprint = json.dumps(prompt, sort_keys=True) if prompt else None
                if fingerprint != prompt_shown:
                    prompt_shown = fingerprint
                    self.emit("permission", prompt or {})

                if time.time() - last_beat > HEARTBEAT:
                    last_beat = time.time()
                    # The status goes out with the beat, not only when it
                    # changes. A client that missed one — a reconnect, a
                    # phone that slept — otherwise sits on whatever it saw
                    # last, and what it saw last was usually "connecting".
                    self.emit("status", {"ready": pane_ready(name),
                                         "profile": session_profile(name)})
                    self.wfile.write(b": beat\n\n")
                    self.wfile.flush()
        except (BrokenPipeError, ConnectionResetError, OSError):
            return
        finally:
            watching(name, -1)

    def emit(self, kind, payload):
        blob = "event: {}\ndata: {}\n\n".format(kind, json.dumps(payload))
        self.wfile.write(blob.encode("utf-8"))
        self.wfile.flush()

    def message(self, data):
        name = data.get("session") or ""
        text = (data.get("text") or "").strip()
        if name not in ccs_sessions():
            return self.reply(404, {"error": "no such session"})
        if not text:
            return self.reply(400, {"error": "empty"})
        # A session being relaunched is still in tmux and still answering the
        # prompt for a few seconds before it is killed. Sending into that gap
        # is how a message typed right after choosing a model disappeared: it
        # went to a process that was about to die. Wait the relaunch out.
        if relaunching(name):
            if not wait_relaunch(name):
                return self.reply(409, {"error": "session restarting"})
        elif not pane_ready(name) and not wait_ready(name, 25.0):
            return self.reply(409, {"error": "session busy"})
        send_to_session(name, text)
        return self.reply(200, {"ok": True})

    def profile(self, data):
        name = data.get("session") or ""
        wanted = data.get("profile") or "-"
        model = data.get("model")
        if name not in ccs_sessions():
            return self.reply(404, {"error": "no such session"})
        if model is not None:
            if wanted == "-":
                set_pool_model(model)
            else:
                set_profile_model(wanted, model)
        ccs("ccs-profile", wanted, name)
        return self.reply(200, {"ok": True, "restarting": True})

    def session(self, data):
        action = data.get("action")
        name = data.get("session") or ""
        if action == "new":
            before = set(ccs_sessions())
            ccs("ccs-pool.sh")
            _CACHE.pop("sessions", None)
            fresh = [n for n in ccs_sessions() if n not in before]
            if not fresh:
                ccs("ccs-new", next_auto_name().replace(CFG["CCS_PREFIX"] + "-", ""))
                _CACHE.pop("sessions", None)
                fresh = [n for n in ccs_sessions() if n not in before]
            return self.reply(200, {"ok": True, "session": fresh[0] if fresh else None})
        if action == "interrupt":
            if name not in ccs_sessions():
                return self.reply(404, {"error": "no such session"})
            # Escape is what the TUI listens for. Stopping a turn is not the
            # same as closing the session, and the session should survive it.
            tmux("send-keys", "-t", name, "Escape")
            return self.reply(200, {"ok": True})
        if action == "rename":
            wanted = (data.get("name") or "").strip()
            if name not in ccs_sessions() or not wanted:
                return self.reply(400, {"error": "bad request"})
            fresh = "".join(c for c in wanted if c.isalnum() or c in "-_")[:48]
            # The prefix is how the pool finds its own tmux sessions among
            # everyone else's, so it goes back on whether or not you typed it.
            # A session renamed out of the prefix is a session we lose.
            prefix = CFG.get("CCS_PREFIX", "")
            if prefix and fresh != prefix and not fresh.startswith(prefix + "-"):
                fresh = "{}-{}".format(prefix, fresh)
            if not fresh or fresh in ccs_sessions():
                return self.reply(400, {"error": "bad name"})
            # The record is the id and the backend; both move with the name or
            # the next session to be called this inherits them.
            for part in ("uuid", "profile", "archived"):
                old = os.path.join(POOLDIR, "{}.{}".format(name, part))
                if os.path.exists(old):
                    os.replace(old, os.path.join(POOLDIR, "{}.{}".format(fresh, part)))
            tmux("rename-session", "-t", name, fresh)
            _CACHE.pop("sessions", None)
            return self.reply(200, {"ok": True, "session": fresh})
        if action == "resume":
            uuid = str(data.get("uuid") or "")
            if not uuid or not uuid.replace("-", "").isalnum():
                return self.reply(400, {"error": "bad id"})
            if not os.path.exists(os.path.join(PROJDIR, uuid + ".jsonl")):
                # Resuming means starting a session, and a session starts in
                # this server's working directory. A conversation held
                # somewhere else can be read, but bringing it back here would
                # file it under a folder it was never in.
                return self.reply(404, {"error": "not this workspace"})
            before = set(ccs_sessions())
            ccs("ccs-resume", uuid)
            _CACHE.pop("sessions", None)
            _CACHE.pop("past", None)
            fresh = [n for n in ccs_sessions() if n not in before]
            return self.reply(200, {"ok": True,
                                    "session": fresh[0] if fresh else None})
        if action in ("archive", "unarchive"):
            # Archiving tidies the list and nothing else. The tmux session and
            # its process keep running, which is why the sheet says so and
            # keeps closing one tap away.
            if name not in ccs_sessions():
                return self.reply(404, {"error": "no such session"})
            mark = os.path.join(POOLDIR, name + ".archived")
            if action == "archive":
                with open(mark, "w", encoding="utf-8") as handle:
                    handle.write(str(int(time.time())) + chr(10))
            else:
                try:
                    os.remove(mark)
                except OSError:
                    pass
            return self.reply(200, {"ok": True})
        if action == "close":
            if name not in ccs_sessions():
                return self.reply(404, {"error": "no such session"})
            ccs("ccs-close", name)
            _CACHE.pop("sessions", None)
            _CACHE.pop("past", None)      # it just became a past conversation
            return self.reply(200, {"ok": True})
        return self.reply(400, {"error": "unknown action"})

    def permission(self, data):
        name = data.get("session") or ""
        key = str(data.get("key") or "")
        if name not in ccs_sessions() or not key.isdigit():
            return self.reply(400, {"error": "bad request"})
        tmux("send-keys", "-t", name, key)
        time.sleep(0.2)
        tmux("send-keys", "-t", name, "Enter")
        return self.reply(200, {"ok": True})

    def upload(self, query):
        """Take a file and put it where the session can open it.

        The name comes from the client, so it is treated as hostile: basename
        only, stripped, and the result still has to land inside the workspace.
        """
        name = os.path.basename((query.get("name") or ["dosya"])[0])
        name = "".join(c for c in name if c.isalnum() or c in "._- ")[:80].strip()
        if not name or name.startswith("."):
            name = "dosya-{}".format(int(time.time()))
        length = int(self.headers.get("Content-Length") or 0)
        if length <= 0 or length > FILE_MAX:
            return self.reply(413, {"error": "size"})

        folder = os.path.join(os.path.realpath(WORKDIR), "gelen")
        os.makedirs(folder, exist_ok=True)
        stem, ext = os.path.splitext(name)
        target = os.path.join(folder, name)
        count = 1
        while os.path.exists(target):
            target = os.path.join(folder, "{}-{}{}".format(stem, count, ext))
            count += 1

        remaining = length
        with open(target, "wb") as handle:
            while remaining > 0:
                chunk = self.rfile.read(min(65536, remaining))
                if not chunk:
                    break
                handle.write(chunk)
                remaining -= len(chunk)
        rel = os.path.relpath(target, os.path.realpath(WORKDIR))
        return self.reply(200, {"ok": True, "path": rel, "kind": kind_of(rel),
                                "size": os.path.getsize(target)})

    def file(self, wanted, raw):
        full = inside(wanted)
        if not full or not os.path.isfile(full):
            return self.reply(404, {"error": "no such file"})
        size = os.path.getsize(full)
        if size > FILE_MAX:
            return self.reply(413, {"error": "too large"})
        kind = kind_of(os.path.basename(full))
        ctype = (mimetypes.guess_type(full)[0]
                 or TEXTY.get(os.path.splitext(full)[1].lower())
                 or "application/octet-stream")
        # A page from the workspace is served as a page, so it can be opened;
        # everything else is served for viewing rather than for running.
        if kind == "page" and not raw:
            ctype = "text/html; charset=utf-8"
        elif kind == "text":
            ctype = "text/plain; charset=utf-8"
        with open(full, "rb") as handle:
            body = handle.read()
        self.send_response(200)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Disposition", 'inline; filename="{}"'.format(
            os.path.basename(full).replace('"', "")))
        self.end_headers()
        try:
            self.wfile.write(body)
        except (BrokenPipeError, ConnectionResetError):
            pass

    # ---- static

    def static(self, path):
        if path in ("/", ""):
            path = "/index.html"
        if path == "/manifest.webmanifest":
            # Generated, not shipped: the app should carry the name of the
            # machine it drives rather than the name of whoever wrote it.
            return self.reply(200, manifest(), "application/manifest+json")
        target = os.path.normpath(os.path.join(WEB, path.lstrip("/")))
        if not target.startswith(WEB) or not os.path.isfile(target):
            return self.reply(404, b"not found", "text/plain")
        ctype = mimetypes.guess_type(target)[0] or "application/octet-stream"
        with open(target, "rb") as handle:
            body = handle.read()
        self.send_response(200)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        # The shell may be cached; the service worker handles its own updates.
        self.send_header("Cache-Control", "no-cache")
        self.end_headers()
        try:
            self.wfile.write(body)
        except (BrokenPipeError, ConnectionResetError):
            pass


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--port", type=int,
                        default=int(CFG.get("CCS_API_PORT") or 8787))
    parser.add_argument("--host", default=CFG.get("CCS_API_HOST") or "127.0.0.1")
    parser.add_argument("--print-token", action="store_true")
    args = parser.parse_args()
    if args.print_token:
        print(TOKEN)
        return
    server = ThreadingHTTPServer((args.host, args.port), Handler)
    server.daemon_threads = True
    if ccs_push.available():
        threading.Thread(target=notifier, daemon=True).start()
    else:
        sys.stderr.write("push disabled: cryptography not installed\n")
    sys.stderr.write("ccs-api on {}:{}\n".format(args.host, args.port))
    server.serve_forever()


if __name__ == "__main__":
    main()
