    name = app_name()
    return {
        "name": name,
        "short_name": name[:12],
        "description": "Claude Code oturumlarini uzaktan surer",
        "start_url": "./",
        "scope": "./",
        "display": "standalone",
        "orientation": "portrait",
        "background_color": "#111417",
        "theme_color": "#111417",
