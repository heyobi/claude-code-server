#!/usr/bin/env python3
"""Exercise the app and say what broke.

    ccs-check              everything
    ccs-check files        uploads, listing, serving, finding again
    ccs-check app          the web app's own consistency

Uploads one file of every kind the app claims to handle — including the names
that have caught us out, the ones with spaces and Turkish letters — then checks
that each one can be listed, served back byte for byte, and, crucially, found
again by the pattern the browser uses to spot a file mentioned in a message.
That last one is where an upload that worked perfectly still ended up invisible.

Everything it makes, it removes.
"""

import base64
import json
import os
import re
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request

HERE = os.path.dirname(os.path.realpath(__file__))
BASE = "http://127.0.0.1:{}".format(os.environ.get("CCS_API_PORT", "8787"))

# The same shape the browser uses, so a disagreement shows up here first.
FILEISH = re.compile(
    r"(?:^|[\s(`\"'>])(/?(?:[\w.-]+/)*[\w.-]+\."
    r"(?:png|jpe?g|gif|webp|svg|avif|mp3|wav|ogg|m4a|flac|mp4|webm|mov|pdf|html?"
    r"|md|csv|json|txt|log|py|js|ts|sh|ya?ml))(?=$|[\s)`\"'.,:;])", re.I)

PNG = base64.b64decode(
    "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQ"
    "DwAEhQGAhKmMIQAAAABJRU5ErkJggg==")

CASES = [
    ("deneme.md", b"# baslik\n"),
    ("deneme.txt", b"metin\n"),
    ("deneme.json", b'{"a":1}\n'),
    ("deneme.csv", b"a,b\n"),
    ("deneme.py", b"print(1)\n"),
    ("deneme.sh", b"echo 1\n"),
    ("deneme.yaml", b"a: 1\n"),
    ("deneme.log", b"satir\n"),
    ("deneme.html", b"<p>hi</p>"),
    ("deneme.png", PNG),
    # The ones that have bitten us.
    ("Bosluklu Ad 2026.md", b"# bosluk\n"),
    ("ozel karakter cogu.pdf", b"%PDF-1.4\n"),
]


def token():
    """Ask whichever copy of ccs-api will actually run.

    Run from a fresh clone, the one next door may not be executable — install.sh
    is what sets that — so the installed copy is tried too, and failing both it
    is handed to the interpreter directly.
    """
    here = os.path.join(HERE, "ccs-api")
    there = os.path.expanduser("~/.local/share/claude-code-server/bin/ccs-api")
    for attempt in ([here], [there], [sys.executable, here]):
        if not os.path.exists(attempt[-1]):
            continue
        try:
            out = subprocess.run(attempt + ["--print-token"],
                                 capture_output=True, text=True, timeout=20)
        except (OSError, subprocess.SubprocessError):
            continue
        if out.stdout.strip():
            return out.stdout.strip()
    return ""


def call(path, data=None, method=None):
    request = urllib.request.Request(BASE + path, data=data, method=method)
    request.add_header("Authorization", "Bearer " + TOKEN)
    if data is not None:
        request.add_header("Content-Type", "application/octet-stream")
    try:
        with urllib.request.urlopen(request, timeout=30) as answer:
            return answer.status, answer.read()
    except urllib.error.HTTPError as bad:
        return bad.code, bad.read()
    except OSError as bad:
        return 0, str(bad).encode()


def check_app():
    """The three numbers, the syntax, and whether what runs is what we wrote.

    A service worker keeps the old files until a client reloads, so markup and
    script have to be versioned together — a phone running new HTML against an
    old script is a bug nobody can reproduce on a desktop. And a change made to
    the deployed copy instead of the source works until the next install and
    then disappears; comparing them catches that while it is still confusing
    rather than after it has been forgotten.
    """
    bad = 0
    web_src = os.path.join(os.path.dirname(HERE), "web")
    if not os.path.isdir(web_src):
        web_src = os.path.join(os.path.expanduser("~/src/claude-code-server"), "web")
    web_run = os.path.expanduser("~/.local/share/claude-code-server/web")

    def read(folder, name):
        try:
            with open(os.path.join(folder, name), encoding="utf-8") as handle:
                return handle.read()
        except OSError:
            return ""

    app = read(web_src, "app.js")
    page = read(web_src, "index.html")
    worker = read(web_src, "sw.js")
    if not (app and page and worker):
        print("app      SKIP    no source to check")
        return 0

    build = re.search(r"const BUILD = 'v(\d+)'", app)
    asked = re.search(r"app\.js\?v=(\d+)", page)
    shell = re.search(r"ccs-shell-v(\d+)", worker)
    got = [m.group(1) if m else "?" for m in (build, asked, shell)]
    same = got[0] == got[1] and got[0] != "?"
    print("%-8s %-7s BUILD=%s  index=%s  sw=%s" % (
        "versions", "ok" if same else "NO", got[0], got[1], got[2]))
    bad += 0 if same else 1

    node = subprocess.run(["node", "--check", os.path.join(web_src, "app.js")],
                          capture_output=True, text=True)
    if node.returncode == 0:
        print("%-8s %-7s" % ("syntax", "ok"))
    elif "No such file" in (node.stderr or "") or node.returncode == 127:
        print("%-8s %-7s node not installed" % ("syntax", "SKIP"))
    else:
        print("%-8s %-7s %s" % ("syntax", "NO", (node.stderr or "").strip()[:90]))
        bad += 1

    if os.path.isdir(web_run):
        drifted = [name for name in ("app.js", "index.html", "sw.js")
                   if read(web_src, name) != read(web_run, name)]
        print("%-8s %-7s %s" % (
            "deployed", "ok" if not drifted else "NO",
            "matches source" if not drifted
            else "differs: " + ", ".join(drifted) + " — run ./install.sh"))
        bad += 1 if drifted else 0
    else:
        print("%-8s %-7s nothing installed" % ("deployed", "SKIP"))
    return bad


WHICH = sys.argv[1] if len(sys.argv) > 1 else "all"

if WHICH in ("all", "app"):
    trouble = check_app()
    if WHICH == "app":
        sys.exit(1 if trouble else 0)
    print()
else:
    trouble = 0

TOKEN = token()
if not TOKEN:
    sys.exit("no api token; is ccs-api installed?")

print("%-24s %-7s %-6s %-7s %s" % ("NAME", "UPLOAD", "SERVE", "SAME", "FOUND IN TEXT"))
made = []
bad = 0
for name, body in CASES:
    code, out = call("/api/upload?name=" + urllib.parse.quote(name), data=body,
                     method="POST")
    try:
        info = json.loads(out)
    except ValueError:
        info = {}
    path = info.get("path", "")
    if not path:
        print("%-24s %-7s %s" % (name[:24], code, "-- upload failed"))
        bad += 1
        continue
    made.append(path)
    scode, got = call("/api/file?path=" + urllib.parse.quote(path))
    same = got == body
    # The message the composer would build, read back the way the app reads it.
    found = FILEISH.findall("Ekli dosya: " + path)
    ok = same and scode == 200 and found == [path]
    bad += 0 if ok else 1
    print("%-24s %-7s %-6s %-7s %s" % (
        name[:24], "ok" if code == 200 else code,
        "ok" if scode == 200 else scode,
        "ok" if same else "NO",
        path if found == [path] else "NO -> {}".format(found or "nothing")))

code, out = call("/api/files?dir=gelen")
listed = {e["name"] for e in json.loads(out or b"{}").get("entries", [])}
missing = [p.split("/")[-1] for p in made if p.split("/")[-1] not in listed]
print()
print("not listed:", missing or "none")
bad += len(missing)

for path in made:
    full = os.path.join(os.path.expanduser("~"), "calisma", path)
    try:
        os.remove(full)
    except OSError:
        pass

print("cleaned up", len(made), "files")
sys.exit(1 if bad + trouble else 0)
