#!/usr/bin/env python3
"""Drive this machine's sessions — and any machine it reaches — as tools.

    claude mcp add ziverbey -- ~/.local/share/claude-code-server/bin/ccs-mcp
    agy mcp add ziverbey ~/.local/share/claude-code-server/bin/ccs-mcp

Everything here is reachable from a shell already, which is why this was not
written first. It earns its place for work that is driven rather than typed: a
scheduled job that asks a question on a backend and files the answer does not
want to compose a command line, read a terminal pane and guess when the answer
is finished. It wants to call `ask` and be handed the text.

It talks to the local API rather than to tmux, which is the whole reason it can
reach the second machine: the API already knows how to forward, so every tool
here works on either machine without knowing that machines exist. Anything the
phone can do, a job can do.

Speaks MCP over stdio: newline-delimited JSON-RPC on stdin and stdout. Nothing
but protocol goes to stdout; anything worth saying goes to stderr.
"""

import json
import os
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

HERE = os.path.dirname(os.path.realpath(__file__))
VERSION = "2025-06-18"
ANSWER_WAIT = 600.0          # seconds to wait for a reply before giving up


def say(line):
    sys.stderr.write(line + "\n")
    sys.stderr.flush()


def setting(key, fallback):
    path = os.path.expanduser("~/.config/claude-code-server/config")
    try:
        with open(path, encoding="utf-8") as handle:
            for line in handle:
                if line.strip().startswith(key + "="):
                    return line.split("=", 1)[1].strip().strip("'\"")
    except OSError:
        pass
    return fallback


BASE = "http://127.0.0.1:" + setting("CCS_API_PORT", "8787")


def token():
    for attempt in ([os.path.join(HERE, "ccs-api")],
                    [sys.executable, os.path.join(HERE, "ccs-api")]):
        try:
            out = subprocess.run(attempt + ["--print-token"],
                                 capture_output=True, text=True, timeout=20)
        except (OSError, subprocess.SubprocessError):
            continue
        if out.stdout.strip():
            return out.stdout.strip()
    return ""


TOKEN = token()


def call(path, body=None, timeout=90):
    data = json.dumps(body).encode() if body is not None else None
    request = urllib.request.Request(BASE + path, data=data,
                                     method="POST" if data else "GET")
    request.add_header("Authorization", "Bearer " + TOKEN)
    if data:
        request.add_header("Content-Type", "application/json")
    with urllib.request.urlopen(request, timeout=timeout) as answer:
        raw = answer.read()
    try:
        return json.loads(raw)
    except ValueError:
        return {"text": raw.decode("utf-8", "ignore")}


def quote(**kwargs):
    return "?" + urllib.parse.urlencode({k: v for k, v in kwargs.items() if v})


# ------------------------------------------------------------------- tools


def tool_sessions(_):
    state = call("/api/state")
    return {
        "machines": state.get("machines", []),
        "sessions": [{
            "session": row["name"],
            "machine": row.get("machine"),
            "backend": row.get("profile"),
            "model": row.get("model"),
            "free": row.get("ready"),
            "last": (row.get("last") or "")[:160],
        } for row in state.get("sessions", [])],
    }


def tool_new(args):
    topic = (args.get("topic") or "").strip()
    machine = (args.get("machine") or "").strip()
    body = {"action": "new"}
    if machine:
        body["machine"] = machine
    made = call("/api/session", body, timeout=180)
    name = made.get("session")
    if not name:
        return {"error": "no session appeared"}
    if topic:
        renamed = call("/api/session", {"action": "rename", "session": name,
                                        "name": topic}, timeout=60)
        name = renamed.get("session") or name
    return {"session": name}


def tool_close(args):
    return call("/api/session", {"action": "close",
                                 "session": args.get("session") or ""})


def tool_profile(args):
    out = call("/api/profile", {"session": args.get("session") or "",
                                "profile": args.get("profile") or "-"},
               timeout=120)
    # The switch kills the session and starts it again. A caller that asked for
    # a backend means to use it, so wait until there is something to use.
    time.sleep(8)
    wait_free(args.get("session") or "", 90)
    return out


def free_now(name):
    for row in call("/api/state").get("sessions", []):
        if row["name"] == name:
            return bool(row.get("ready"))
    return False


def wait_free(name, limit):
    began = time.time()
    while time.time() - began < limit:
        if free_now(name):
            return True
        time.sleep(2)
    return False


def tool_ask(args):
    """Send a question and return the answer, rather than the fact of sending."""
    name = args.get("session") or ""
    text = (args.get("text") or "").strip()
    limit = float(args.get("wait") or ANSWER_WAIT)
    if not name or not text:
        return {"error": "session and text are both required"}

    before = call("/api/history" + quote(session=name))
    if "turns" not in before:
        return {"error": before.get("error", "no such session")}
    seen = {t.get("id") for t in before["turns"]}

    if not free_now(name) and not wait_free(name, 90):
        return {"error": "session did not become free"}
    sent = call("/api/message", {"session": name, "text": text}, timeout=180)
    if sent.get("error"):
        return sent

    began = time.time()
    said = []
    while time.time() - began < limit:
        time.sleep(2)
        now = call("/api/history" + quote(session=name))
        fresh = [t for t in now.get("turns", []) if t.get("id") not in seen]
        said = [t["text"] for t in fresh
                if t["role"] == "assistant" and t.get("text")]
        if said and free_now(name):
            return {"session": name, "answer": "\n\n".join(said),
                    "seconds": round(time.time() - began, 1)}
    return {"error": "timed out", "partial": "\n\n".join(said)}


def tool_conversation(args):
    limit = int(args.get("limit") or 60)
    if args.get("session"):
        got = call("/api/history" + quote(session=args["session"]))
    elif args.get("uuid"):
        got = call("/api/past/turns" + quote(uuid=args["uuid"]))
    else:
        return {"error": "session or uuid is required"}
    keep = [{"who": t["role"], "when": (t.get("ts") or "")[:16], "said": t["text"]}
            for t in got.get("turns", [])
            if t["role"] in ("user", "assistant") and t.get("text")]
    return {"turns": keep[-limit:]}


def tool_archive(args):
    """Conversations that are closed but still on the disk."""
    rows = call("/api/past").get("entries", [])
    needle = (args.get("about") or "").strip().lower()
    if needle:
        rows = [r for r in rows if needle in (r.get("topic") or "").lower()]
    return {"conversations": [{
        "uuid": r["uuid"], "topic": r["topic"], "folder": r.get("dir"),
        "resumable": r.get("here"), "when": r.get("at"),
    } for r in rows[:int(args.get("limit") or 30)]]}


def tool_resume(args):
    """Bring a closed conversation back as a live session."""
    return call("/api/session", {"action": "resume", "uuid": args.get("uuid") or ""},
                timeout=180)


def tool_files(args):
    where = quote(session=args["session"]) if args.get("session") \
        else quote(dir=args.get("dir") or "")
    got = call("/api/files" + where)
    return {"files": [{"path": e["path"], "kind": e.get("kind"),
                       "bytes": e.get("size")} for e in got.get("entries", [])]}


def tool_read(args):
    path = args.get("path") or ""
    if not path:
        return {"error": "path is required"}
    got = call("/api/file" + quote(path=path), timeout=60)
    text = got.get("text") if isinstance(got, dict) else str(got)
    return {"path": path, "text": (text or "")[:40000]}


def tool_search(args):
    """Find a phrase across every conversation on this machine.

    Searching the raw file is quick and useless: what comes back is JSON
    plumbing around the words. The lines are parsed and the match is reported
    as the sentence somebody actually said.
    """
    sys.path.insert(0, HERE)
    from ccs_common import PROJDIR                 # noqa: PLC0415

    needle = (args.get("text") or "").strip().lower()
    if len(needle) < 3:
        return {"error": "give at least three characters"}
    limit = int(args.get("limit") or 20)
    hits = []
    root = os.path.dirname(PROJDIR)
    for folder in sorted(os.listdir(root)):
        full = os.path.join(root, folder)
        if not os.path.isdir(full):
            continue
        for entry in sorted(os.listdir(full),
                            key=lambda f: -os.path.getmtime(os.path.join(full, f))):
            if not entry.endswith(".jsonl"):
                continue
            target = os.path.join(full, entry)
            try:
                with open(target, encoding="utf-8", errors="ignore") as handle:
                    raw = handle.read()
            except OSError:
                continue
            if needle not in raw.lower():
                continue                          # cheap check before the dear one
            topic = ""
            for line in raw.splitlines():
                try:
                    item = json.loads(line)
                except ValueError:
                    continue
                said = text_of(item)
                if not said:
                    continue
                if not topic and item.get("type") == "user":
                    topic = " ".join(said.split())[:60]
                where = said.lower().find(needle)
                if where < 0:
                    continue
                hits.append({
                    "uuid": entry[:-6], "topic": topic, "who": item.get("type"),
                    "when": (item.get("timestamp") or "")[:16].replace("T", " "),
                    "said": " ".join(
                        said[max(0, where - 100):where + 160].split())[:240],
                })
                if len(hits) >= limit:
                    return {"hits": hits, "more": True}
    return {"hits": hits, "more": False}


def text_of(item):
    body = (item.get("message") or {}).get("content")
    if isinstance(body, str):
        return body
    if isinstance(body, list):
        return " ".join(part.get("text", "") for part in body
                        if isinstance(part, dict) and part.get("type") == "text")
    return ""


def field(kind, what):
    return {"type": kind, "description": what}


TOOLS = [
    {"name": "sessions", "run": tool_sessions,
     "description": "Every session on every machine reachable from here, with "
                    "the backend it runs on and whether it is free.",
     "inputSchema": {"type": "object", "properties": {}}},

    {"name": "ask", "run": tool_ask,
     "description": "Send a question to a session and wait for the answer. "
                    "Returns the text, not an acknowledgement. A session on the "
                    "antigravity backend answers without spending the Claude "
                    "subscription.",
     "inputSchema": {"type": "object", "required": ["session", "text"],
                     "properties": {
                         "session": field("string", "session name"),
                         "text": field("string", "what to ask"),
                         "wait": field("number", "seconds to wait, default 600")}}},

    {"name": "new_session", "run": tool_new,
     "description": "Start a session and wait for it to come up. Name the "
                    "machine to start it elsewhere; leave it out for this one.",
     "inputSchema": {"type": "object", "properties": {
         "topic": field("string", "what to call it"),
         "machine": field("string", "which machine, from the sessions tool")}}},

    {"name": "set_profile", "run": tool_profile,
     "description": "Move a session onto a backend: '-' for the Claude login, "
                    "'antigravity' for no subscription, or another configured "
                    "profile. Relaunches it and waits.",
     "inputSchema": {"type": "object", "required": ["session", "profile"],
                     "properties": {"session": field("string", ""),
                                    "profile": field("string", "")}}},

    {"name": "close_session", "run": tool_close,
     "description": "End a session. The transcript stays and can be resumed.",
     "inputSchema": {"type": "object", "required": ["session"],
                     "properties": {"session": field("string", "")}}},

    {"name": "conversation", "run": tool_conversation,
     "description": "Read a conversation, live or closed, by session name or by "
                    "transcript id.",
     "inputSchema": {"type": "object", "properties": {
         "session": field("string", ""), "uuid": field("string", ""),
         "limit": field("number", "last N turns, default 60")}}},

    {"name": "archive", "run": tool_archive,
     "description": "Closed conversations still on the disk, newest first. "
                    "Reading one costs nothing; only ones from this workspace "
                    "can be resumed.",
     "inputSchema": {"type": "object", "properties": {
         "about": field("string", "only ones whose topic contains this"),
         "limit": field("number", "how many, default 30")}}},

    {"name": "resume", "run": tool_resume,
     "description": "Bring a closed conversation back as a live session, under "
                    "the id it already had.",
     "inputSchema": {"type": "object", "required": ["uuid"],
                     "properties": {"uuid": field("string", "")}}},

    {"name": "files", "run": tool_files,
     "description": "Files a conversation touched, or a folder in the workspace.",
     "inputSchema": {"type": "object", "properties": {
         "session": field("string", "files this session touched"),
         "dir": field("string", "a folder, relative to the workspace")}}},

    {"name": "read_file", "run": tool_read,
     "description": "Read a text file from the workspace.",
     "inputSchema": {"type": "object", "required": ["path"],
                     "properties": {"path": field("string", "")}}},

    {"name": "search_archive", "run": tool_search,
     "description": "Find a phrase across every conversation on this machine, "
                    "including ones imported from elsewhere. Returns where it "
                    "was said, with the sentence around it.",
     "inputSchema": {"type": "object", "required": ["text"],
                     "properties": {"text": field("string", ""),
                                    "limit": field("number", "default 20")}}},
]

BY_NAME = {tool["name"]: tool for tool in TOOLS}


# ---------------------------------------------------------------- protocol


def handle(message):
    method = message.get("method")
    params = message.get("params") or {}

    if method == "initialize":
        asked = params.get("protocolVersion")
        return {"protocolVersion": asked if isinstance(asked, str) else VERSION,
                "capabilities": {"tools": {}},
                "serverInfo": {"name": setting("CCS_PREFIX", "ziverbey"),
                               "version": "2"}}
    if method == "tools/list":
        return {"tools": [{k: v for k, v in tool.items() if k != "run"}
                          for tool in TOOLS]}
    if method == "tools/call":
        tool = BY_NAME.get(params.get("name"))
        if not tool:
            raise LookupError("no tool called {}".format(params.get("name")))
        result = tool["run"](params.get("arguments") or {})
        return {"content": [{"type": "text",
                             "text": json.dumps(result, ensure_ascii=False,
                                                indent=1)}],
                "isError": bool(isinstance(result, dict) and result.get("error"))}
    if method == "ping":
        return {}
    raise LookupError("no method called {}".format(method))


def main():
    if not TOKEN:
        say("ccs-mcp: no api token; is ccs-api installed and running?")
    say("ccs-mcp ready on stdio, talking to " + BASE)
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            message = json.loads(line)
        except ValueError:
            continue
        if "id" not in message:                    # a notification takes no answer
            continue
        try:
            answer = {"jsonrpc": "2.0", "id": message["id"],
                      "result": handle(message)}
        except LookupError as missing:
            answer = {"jsonrpc": "2.0", "id": message["id"],
                      "error": {"code": -32601, "message": str(missing)}}
        except Exception as bad:                   # noqa: BLE001
            say("tool failed: {}".format(bad))
            answer = {"jsonrpc": "2.0", "id": message["id"],
                      "error": {"code": -32603, "message": str(bad)}}
        sys.stdout.write(json.dumps(answer, ensure_ascii=False) + "\n")
        sys.stdout.flush()


if __name__ == "__main__":
    try:
        main()
    except (KeyboardInterrupt, BrokenPipeError):
        pass
