#!/usr/bin/env bash
# Launch claude under a backend profile.
#
#   ccs-launch <profile|-> <claude args...>
#
# A profile is a plain env file at ~/.config/claude-code-server/profiles/<name>.env.
# Use "-" for no profile, which means Claude Code's own login and models.
#
# Backends are chosen by environment (ANTHROPIC_BASE_URL and friends), and the
# environment is fixed when the process starts. That is why switching backends
# means relaunching the session rather than flipping a setting inside it.
set -uo pipefail

profile="${1:--}"
shift || true

if [ "$profile" != "-" ]; then
  file="${CCS_PROFILES:-$HOME/.config/claude-code-server/profiles}/${profile}.env"
  if [ -f "$file" ]; then
    set -a
    # shellcheck source=/dev/null
    . "$file"
    set +a
  else
    printf 'ccs-launch: no profile named %s at %s\n' "$profile" "$file" >&2
    printf 'Falling back to the default backend.\n' >&2
    sleep 2
  fi
fi

export PATH="$HOME/.npm-global/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

# A profile may run behind a gateway that is not kept running: ours is a
# LiteLLM container, the largest thing on the machine, useful only to sessions
# on that one profile and usually none of them. Bring it up and wait for it to
# answer — claude's first request would otherwise land on a closed port, and
# the session would come up broken with no clue why.
if [ -n "${CCS_PROFILE_UP:-}" ] && [ "$profile" != "-" ]; then
  "$(dirname "$(readlink -f "$0")")/ccs-gateway" up "$profile" || true
fi

# After each answer Claude Code asks the model to guess what you might type
# next. On your own subscription that is invisible; in front of a metered
# backend it is a second full request per turn, and it cost about as much as the
# answer did. Export the variable yourself to keep them.
export CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION="${CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION:-false}"

# A gateway that keeps state per conversation needs to tell our sessions apart,
# and nothing in the request body does: the metadata carries a device id, shared
# by all of them. Hand it the session name instead. Harmless when the backend is
# Anthropic, which ignores headers it does not know.
for i in "$@"; do
  if [ "${prev:-}" = "--remote-control" ]; then
    export ANTHROPIC_CUSTOM_HEADERS="X-CCS-Session: $i"
    break
  fi
  prev="$i"
done

# A profile can name the model to ask for, which matters for gateways where the
# model name is whatever the gateway config calls it. It wins over any --model
# the pool already put on the command line.
if [ -n "${CCS_PROFILE_MODEL:-}" ]; then
  args=()
  skip=0
  for a in "$@"; do
    if [ "$skip" = 1 ]; then skip=0; continue; fi
    if [ "$a" = "--model" ]; then skip=1; continue; fi
    args+=("$a")
  done
  set -- "${args[@]}" --model "$CCS_PROFILE_MODEL"
fi

exec claude "$@"
